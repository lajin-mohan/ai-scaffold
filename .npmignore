# Keep the published package focused on the CLI plus scaffold-managed assets.
# The package.json "files" allowlist is the primary control; these entries prune
# application-like examples and local/editor-only files if they are matched.

templates/*/apps/
templates/*/_ai/
templates/*/docs/
templates/*/infra/
templates/*/packages/
templates/*/scripts/
templates/*/tasks/
templates/*/.vscode/
templates/*/.claude/settings.local.json

src/__tests__/
tests/
docs/process/
docs/estimates/
