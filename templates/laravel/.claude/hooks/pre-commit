#!/bin/bash
# pre-commit — developer helper: catches issues before they reach CI.
#
# What it does:
#   - Branch name validation (always)
#   - Stack-specific checks: lint, typecheck, unit tests (if tools installed)
#   - The project's verify script, scripts/verify, in place of the stack's
#     test step when the project commits one
#   - Secrets scan (if gitleaks installed)
#
# scripts/verify is the team's contract for "what must pass before code is
# shared". Commit it when the stack default does not fit, for example a
# monorepo whose root test needs a database. It runs with bash, so it needs no
# executable bit, and it must exist and pass: there is no per-developer override.
#
# Stack detection by file presence:
#   package.json    → Node/TypeScript (npm run lint, npm run typecheck, npm test)
#   composer.json   → PHP (PHP CS Fixer, PHPStan, PHPUnit)
#   pyproject.toml  → Python (ruff, pyright/mypy, pytest)
#   go.mod          → Go (go build, go vet, go test)
#   *.csproj        → .NET (dotnet build, dotnet test)
#
# IMPORTANT: This is a developer convenience tool, not a hard quality gate.
# Missing tools → checks are silently skipped (see "skipping" messages below).
# CI is the authoritative gate — it runs all configured checks with all tools available.
#
# Install:
#   ./scripts/install-hooks.sh
#   (sets core.hooksPath + chmod +x on all hooks in one command)
#
# To bypass (emergency only): git commit --no-verify

set -euo pipefail

PASS=0
FAIL=0
VERIFY_SCRIPT=scripts/verify
HAS_VERIFY=0
[ -f "$VERIFY_SCRIPT" ] && HAS_VERIFY=1

# Runs the stack's test step unless the project's verify script replaces it.
run_tests() {
  if [ $HAS_VERIFY -eq 1 ]; then
    echo "(test step replaced by $VERIFY_SCRIPT)"
    return 0
  fi
  run_check "$1" "$2"
}

run_verify() {
  echo ">> pre-commit: $VERIFY_SCRIPT"
  local status=0
  bash "$VERIFY_SCRIPT" > /tmp/check_output 2>&1 || status=$?
  if [ $status -eq 0 ]; then
    echo "   OK: $VERIFY_SCRIPT"
    PASS=$((PASS + 1))
    return 0
  fi
  echo "   FAIL: $VERIFY_SCRIPT (exit $status)"
  cat /tmp/check_output
  if [ $status -eq 127 ]; then
    echo "   A command in $VERIFY_SCRIPT was not found. Install it, or change"
    echo "   $VERIFY_SCRIPT in a reviewed commit."
  fi
  FAIL=$((FAIL + 1))
}

fail_summary() {
  echo ""
  echo "Pre-commit checks failed. Fix the failures above before committing."
  if [ $HAS_VERIFY -eq 0 ]; then
    echo "If the stack's test step cannot pass locally (for example it needs a"
    echo "database), commit a $VERIFY_SCRIPT that runs the checks every commit must"
    echo "pass. The header of .claude/hooks/pre-commit explains it."
  fi
}

run_check() {
  local name="$1"
  local cmd="$2"
  echo ">> pre-commit: $name"
  if eval "$cmd" > /tmp/check_output 2>&1; then
    echo "   OK: $name"
    PASS=$((PASS + 1))
  else
    echo "   FAIL: $name"
    cat /tmp/check_output
    FAIL=$((FAIL + 1))
  fi
}

echo "========================================"
echo " Pre-commit checks"
echo "========================================"

# Branch policy — always runs.
# Two separate checks: you must not be ON an integration branch, and if you
# are on a work branch its name must be well formed. See
# .claude/rules/branching-rules.md for the flow these enforce.
BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
if [ -n "$BRANCH_NAME" ] && [ "$BRANCH_NAME" != "HEAD" ]; then
  if echo "$BRANCH_NAME" | grep -qE '^(main|dev|master)$'; then
    echo "   FAIL: direct commit to '$BRANCH_NAME' is not allowed."
    echo "         '$BRANCH_NAME' only ever changes through a merged pull request."
    echo "         Move this work to a branch and open a PR:"
    echo "           git switch -c feature/short-description"
    echo "         Branch from dev for all normal work; hotfix/* from main is the"
    echo "         only documented exception. See .claude/rules/branching-rules.md"
    FAIL=$((FAIL + 1))
  elif ! echo "$BRANCH_NAME" | grep -qE '^(feature|fix|chore|docs|hotfix)/[a-zA-Z0-9._-]+$'; then
    echo "   FAIL: Branch name '$BRANCH_NAME' does not match required pattern:"
    echo "         feature/*, fix/*, chore/*, docs/*, hotfix/*"
    echo "         See .claude/rules/branching-rules.md"
    FAIL=$((FAIL + 1))
  else
    echo "   OK: Branch name '$BRANCH_NAME'"
  fi
fi

# Template / pre-bootstrap state — no stack files found
if [ $HAS_VERIFY -eq 0 ] && [ ! -f package.json ] && [ ! -f composer.json ] && [ ! -f pyproject.toml ] && [ ! -f go.mod ] && ! ls *.csproj 1>/dev/null 2>&1; then
  echo "(no project stack detected — template state, skipping stack checks)"
  # Branch policy still applies with no stack configured; exiting 0 here
  # unconditionally would report a violation and then allow the commit anyway.
  if [ $FAIL -gt 0 ]; then
    fail_summary
    exit 1
  fi
  echo "Template validation passed. Run /ais-bootstrap to configure checks."
  exit 0
fi


# ── Node / TypeScript ──────────────────────────────────────────
if [ -f package.json ]; then
  if command -v npm &>/dev/null; then
    # Only run a script the project actually defines. A profile that declares a
    # capability as `none` ships no such script, and failing on its absence
    # would block a fresh project's very first commit — the same defect fixed
    # for laravel in v0.11.0. A missing script is "not applicable", not a
    # failure, consistent with how missing tools are treated above.
    has_script() { node -e "process.exit(require('./package.json').scripts?.['$1']?0:1)" 2>/dev/null; }
    if has_script lint; then run_check "ESLint" "npm run lint -- --max-warnings 0"; else echo "(no lint script — skipping)"; fi
    if has_script typecheck; then run_check "TypeScript" "npm run typecheck"; else echo "(no typecheck script — skipping)"; fi
    if has_script test; then run_tests "Unit Tests" "npm test"; else echo "(no test script — skipping)"; fi
  else
    echo "(npm not found — skipping Node checks)"
  fi
fi

# ── PHP / Laravel ──────────────────────────────────────────────
if [ -f composer.json ]; then
  if command -v composer &>/dev/null && [ -d vendor ]; then
    run_check "PHP CS Fixer" "vendor/bin/php-cs-fixer fix --dry-run --diff"
    run_check "PHPStan" "vendor/bin/phpstan analyse"
    run_tests "PHPUnit" "vendor/bin/phpunit --testsuite=unit"
  else
    echo "(composer not found or no vendor/ — skipping PHP checks)"
  fi
fi

# ── Python ─────────────────────────────────────────────────────
if [ -f pyproject.toml ] || [ -f requirements.txt ]; then
  if command -v ruff &>/dev/null; then
    run_check "Ruff" "ruff check ."
  else
    echo "(ruff not found — skipping Ruff)"
  fi
  if command -v pyright &>/dev/null; then
    run_check "Pyright" "pyright"
  elif command -v mypy &>/dev/null; then
    run_check "MyPy" "mypy ."
  else
    echo "(pyright/mypy not found — skipping type check)"
  fi
  if command -v pytest &>/dev/null; then
    run_tests "pytest" "pytest"
  else
    echo "(pytest not found — skipping tests)"
  fi
fi

# ── Go ────────────────────────────────────────────────────────
if [ -f go.mod ]; then
  if command -v go &>/dev/null; then
    run_check "Go build" "go build ./..."
    run_check "Go vet" "go vet ./..."
    run_tests "Go tests" "go test ./..."
  else
    echo "(go not found — skipping Go checks)"
  fi
fi

# ── .NET / C# ─────────────────────────────────────────────────
if ls *.csproj 1>/dev/null 2>&1; then
  if command -v dotnet &>/dev/null; then
    run_check "dotnet build" "dotnet build --no-restore"
    run_tests "dotnet test" "dotnet test --no-build"
  else
    echo "(dotnet not found — skipping .NET checks)"
  fi
fi

# ── Project verify script — replaces the stack test step ───────
if [ $HAS_VERIFY -eq 1 ]; then
  run_verify
fi

# ── Secrets scanning — always runs if installed ─────────────────
if command -v gitleaks &>/dev/null; then
  run_check "Gitleaks" "gitleaks git --staged --exit-code 1"
else
  echo "(gitleaks not installed — skipping secrets scan)"
  echo "  Install: brew install gitleaks (macOS) or go install github.com/gitleaks/gitleaks@latest"
fi

echo ""
echo "========================================"
echo " Results: $PASS OK / $FAIL FAIL"
echo "========================================"

if [ $FAIL -gt 0 ]; then
  fail_summary
  exit 1
fi

echo "OK: Ready to commit."
exit 0
