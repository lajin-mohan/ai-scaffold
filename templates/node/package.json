{
  "name": "ai-scaffold",
  "version": "0.7.0",
  "description": "Node.js project scaffold with AI engineering workflow",
  "type": "module",
  "bin": {
    "ai-scaffold": "./bin/ai-scaffold.js"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/vitest/vitest.mjs --run",
    "test:unit": "node --experimental-vm-modules node_modules/vitest/vitest.mjs run src/ --run",
    "test:e2e": "node --experimental-vm-modules node_modules/vitest/vitest.mjs run tests/ --run",
    "lint": "echo 'No linter configured yet'",
    "typecheck": "node --check bin/ai-scaffold.js"
  },
  "keywords": [
    "scaffold",
    "ai",
    "node",
    "javascript",
    "claude",
    "project-template",
    "boilerplate"
  ],
  "author": "Techversant Infotech",
  "license": "UNLICENSED",
  "dependencies": {
    "cac": "^6.7.14",
    "chalk": "^5.3.0",
    "diff": "^5.2.0",
    "fs-extra": "^11.2.0",
    "picomatch": "^4.0.0",
    "prompts": "^2.4.2",
    "semver": "^7.6.3"
  },
  "devDependencies": {
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
