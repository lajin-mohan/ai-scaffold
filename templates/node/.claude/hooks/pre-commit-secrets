#!/bin/bash
# pre-commit-secrets — scans staged files for committed secrets using gitleaks.
#
# This runs as a separate hook so gitleaks can be upgraded independently.
# If gitleaks is not installed, this hook exits 0 (skips gracefully).
#
# Install (one-time):
#   ln -sf ../../.claude/hooks/pre-commit-secrets .git/hooks/pre-commit-secrets
#   chmod +x .claude/hooks/pre-commit-secrets
#
# Or combined with pre-commit.sh via git config core.hooksPath .claude/hooks
set -euo pipefail

echo ">> Scanning staged files for secrets..."

# Get list of staged files (added, modified, copied)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$STAGED_FILES" ]; then
  echo "   OK: No staged files to scan"
  exit 0
fi

# gitleaks must be installed; skip if not present
if ! command -v gitleaks &>/dev/null; then
  echo "(gitleaks not installed — skipping secrets scan)"
  echo "  Install: brew install gitleaks  # macOS"
  echo "  Or:     go install github.com/gitleaks/gitleaks@latest  # Linux/Windows"
  exit 0
fi

# Scan the staged git diff with gitleaks.
# `gitleaks git --staged` scans staged changes — the pre-commit use case
# (gitleaks v8.19+ replaced the old `detect --staged` form with the `git`
# subcommand). --exit-code 1 = fail the commit when secrets are found.
RESULT=$(gitleaks git --staged --exit-code 1 2>&1) || {
  echo ""
  echo "FAIL: Secrets detected in staged files:"
  echo "$RESULT"
  echo ""
  echo "Remediation:"
  echo "  1. Remove the secret from the file and re-stage"
  echo "  2. If the secret is a false positive, add the path to .gitleaks.toml [allowlist]"
  echo "  3. For emergencies, bypass with: git commit --no-verify"
  exit 1
}

echo "   OK: No secrets detected in staged files"
exit 0