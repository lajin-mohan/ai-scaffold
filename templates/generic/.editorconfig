# EditorConfig — shared formatting baseline across IDEs.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown: preserve trailing whitespace (line breaks)
[*.md]
trim_trailing_whitespace = false

# Python: PEP 8
[*.py]
indent_size = 4

# PHP: PSR-12
[*.php]
indent_size = 4

# Makefiles require tabs
[{Makefile,*.mk}]
indent_style = tab

# Shell scripts
[*.sh]
end_of_line = lf
indent_size = 2
