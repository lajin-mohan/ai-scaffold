{
  "name": "ai-scaffold",
  "version": "0.7.0",
  "description": "Reusable AI engineering scaffold with CLI distribution",
  "type": "module",
  "bin": {
    "ai-scaffold": "./bin/ai-scaffold.js"
  },
  "files": [
    "bin/",
    "src/",
    "templates/",
    "README.md",
    "README.scaffold.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/vitest/vitest.mjs --run",
    "test:unit": "node --experimental-vm-modules node_modules/vitest/vitest.mjs run src/",
    "test:e2e": "node --experimental-vm-modules node_modules/vitest/vitest.mjs run tests/",
    "lint": "echo 'No linter configured yet'",
    "typecheck": "node --check bin/ai-scaffold.js"
  },
  "keywords": [
    "scaffold",
    "ai",
    "claude",
    "project-template",
    "boilerplate"
  ],
  "author": "Techversant Infotech",
  "license": "MIT",
  "aiScaffold": {
    "documentation": {
      "scaffoldReadme": "README.scaffold.md",
      "generatedReadmeTemplate": "README.template.md",
      "generatedReadmeOutput": "README.md",
      "attributionRegister": "docs/compliance/third-party-attributions.md"
    }
  },
  "dependencies": {
    "cac": "^6.7.14",
    "chalk": "^5.3.0",
    "diff": "^5.2.0",
    "fs-extra": "^11.2.0",
    "picomatch": "^4.0.0",
    "prompts": "^2.4.2",
    "semver": "^7.6.3"
  },
  "devDependencies": {
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
