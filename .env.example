# Environment variables — copy to .env and fill in real values.
# .env is gitignored. .env.example is the contract: every variable the app
# reads at runtime must be declared here with a placeholder and a comment.
#
# Stack: Node.js + TypeScript + ReactJS + PHP + PostgreSQL + AWS, multi-tenant SaaS.

# ─────────────────────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────────────────────
NODE_ENV=development          # development | test | staging | production
PORT=3000                     # API server port
LOG_LEVEL=info                # debug | info | warn | error
APP_BASE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/dbname
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=false            # true in staging/production

# ─────────────────────────────────────────────────────────────
# Cache / Queue (Redis or pg-boss)
# ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────
# Auth (opaque session tokens — see security-rules.md)
# ─────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-random-32-byte-string
SESSION_MAX_AGE_SECONDS=28800       # 8h absolute timeout
SESSION_INACTIVITY_SECONDS=1800     # 30min inactivity timeout
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false                  # true in staging/production

# ─────────────────────────────────────────────────────────────
# Multi-tenancy (per CLAUDE.md IS_MULTI_TENANT=true)
# ─────────────────────────────────────────────────────────────
DEFAULT_TENANT_ID=                   # leave blank in prod; set per-environment in dev/test only

# ─────────────────────────────────────────────────────────────
# Email provider (replace with your provider — Resend / SendGrid / SES)
# ─────────────────────────────────────────────────────────────
EMAIL_PROVIDER=resend                # resend | sendgrid | ses | console (dev only)
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=Your Product

# ─────────────────────────────────────────────────────────────
# Storage (AWS S3 by default)
# ─────────────────────────────────────────────────────────────
S3_BUCKET=
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Prefer IAM role over access keys in staging/production.

# ─────────────────────────────────────────────────────────────
# Rate limiting
# ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_READ=100
RATE_LIMIT_MAX_WRITE=20
RATE_LIMIT_LOGIN_MAX=5

# ─────────────────────────────────────────────────────────────
# Frontend (Vite — must use VITE_ prefix to be exposed to the browser)
# ─────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_PUBLIC_APP_NAME=Your Product

# ─────────────────────────────────────────────────────────────
# Observability
# ─────────────────────────────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ─────────────────────────────────────────────────────────────
# CI / Test (used only in CI)
# ─────────────────────────────────────────────────────────────
# CI_DATABASE_URL=postgres://test:test@localhost:5432/test
